# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
*.tsbuildinfo

# ── Environment files ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# Keep .env.example files — they are safe to commit
!.env.example

# ── Uploads (user-generated content, never commit) ────────────────────────────
uploads/
apps/api/assets/presets/*.webp

# ── Prisma generated client (reproducible via prisma generate) ────────────────
apps/api/node_modules/.prisma/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / editor junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc tooling cache ────────────────────────────────────────────────────────
.cache/
.turbo/
.eslintcache
.parcel-cache/
